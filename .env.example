# Desenvolvimento sem Apache: na raiz do projeto rode "npm run dev:full" (sobe PHP na 8090 + Vite).
# Ou mantenha o WAMP online e use só "npm run dev".

# URL base do backend PHP (Apache WAMP ou "php -S").
VITE_WAMP_API_TARGET=http://127.0.0.1

# Caminho no servidor onde está a pasta api (sem host). Com dev:full use o arquivo .env.php-api (prefix /).
VITE_WAMP_API_PREFIX=/consorcio/api
